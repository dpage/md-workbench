<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store sandbox requirement -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allow read/write access to user-selected files via Open/Save dialogs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow app-scoped bookmarks to remember user-selected file locations -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- Network access for AI chat API calls -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow printing documents -->
    <key>com.apple.security.print</key>
    <true/>
</dict>
</plist>
