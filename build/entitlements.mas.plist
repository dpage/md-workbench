<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store sandbox requirement -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allow read/write access to user-selected files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow read access to Downloads folder for opening files -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Network access for loading ads -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- In-app purchases -->
    <key>com.apple.security.in-app-payments</key>
    <true/>

    <!-- Team ID - required for App Store builds -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)com.example.mdworkbench</string>
    </array>
</dict>
</plist>
