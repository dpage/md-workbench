{
  "name": "md-workbench",
  "version": "1.1.0",
  "description": "Markdown Workbench - A cross-platform markdown viewer",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "webpack --config webpack.main.config.js --mode development && electron .",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-dmg-bg": "node scripts/generate-dmg-background.js",
    "clean:release": "rm -rf release",
    "package:win": "npm run clean:release && electron-builder --win --config electron-builder.config.js",
    "package:mac": "npm run clean:release && electron-builder --mac --config electron-builder.config.js",
    "package:mac-mas": "npm run clean:release && electron-builder --mac --config electron-builder.config.js --config.mac.target=mas",
    "package:linux": "npm run clean:release && electron-builder --linux --config electron-builder.config.js",
    "package:all": "npm run clean:release && electron-builder --win --mac --linux --config electron-builder.config.js"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@electron/rebuild": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.7",
    "css-loader": "^7.1.5",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^12.0.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "katex": "^0.19.1",
    "mdworkbench-bookmarks": "file:native/bookmarks",
    "mermaid": "^12.3.0",
    "prettier": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql-formatter": "^15.9.0"
  },
  "keywords": [
    "electron",
    "react",
    "typescript"
  ],
  "author": "Dave Page",
  "license": "PostgreSQL"
}
